<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mosip.testrig.uitestrig</groupId>
        <artifactId>uitestrig-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>uitest-ai</artifactId>
    <!-- Declared directly (duplicating the parent) so the shared CI workflow's version
         check, which reads project/version without resolving Maven inheritance, can see it. -->
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>uitest-ai</name>
    <description>Optional AI-powered failure analysis for uitest-commons — injected into failing Cucumber
        scenarios to diagnose root cause, suggest fixes, and propose healed locators.
        Supports Ollama (free/local), Claude, and OpenAI as pluggable providers.
        Add alongside uitest-commons; activate with ai.enabled=yes in uitest.properties.</description>

    <dependencies>

        <!-- uitest-commons — brings Playwright, Cucumber, SLF4J, Jackson transitively -->
        <dependency>
            <groupId>io.mosip.testrig.uitestrig</groupId>
            <artifactId>uitest-commons</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            No LLM SDK dependencies are included intentionally.
            All three provider clients use java.net.http.HttpClient (JDK 21) with
            manually constructed JSON request bodies and Jackson (transitive) for
            response parsing.  Provider selection is done at runtime via
            ai.provider=ollama|claude|openai.
        -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
